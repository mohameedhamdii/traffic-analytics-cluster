      "pluginVersion": "10.2.0",
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB" },
          "query": "from(bucket: \"traffic\")\n  |> range(start: -1m)\n  |> filter(fn: (r) => r._measurement == \"node_health\" and r._field == \"online\" and r._value == 1)\n  |> distinct(column: \"node_id\")\n  |> count()\n  |> yield(name: \"online_nodes\")",
          "refId": "A"
        }
      ],
      "title": "Nodes Online",
      "type": "stat"
    },
    {
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
