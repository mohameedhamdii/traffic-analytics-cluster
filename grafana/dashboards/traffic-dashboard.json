        "showThresholdMarkers": true
      },
      "pluginVersion": "10.2.0",
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB" },
          "query": "from(bucket: \"traffic\")\n  |> range(start: -2m)\n  |> filter(fn: (r) => r._measurement == \"parking_summary\" and r._field == \"occupancy_rate\")\n  |> mean()\n  |> yield(name: \"occupancy_rate\")",
          "refId": "A"
        }
      ],
      "title": "Parking Occupancy",
