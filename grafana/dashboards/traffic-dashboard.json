      "pluginVersion": "10.2.0",
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB" },
          "query": "from(bucket: \"traffic\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"avg_speed\" and r._field == \"speed_kmh\")\n  |> mean()\n  |> yield(name: \"avg_speed\")",
          "refId": "A"
        }
      ],
      "title": "Average Speed",
      "type": "gauge"
    },
