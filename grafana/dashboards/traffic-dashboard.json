  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🚦 Live Traffic Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "description": "Total vehicles counted across all nodes in the last minute",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.2.0",
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB" },
          "query": "from(bucket: \"traffic\")\n  |> range(start: -2m)\n  |> filter(fn: (r) => r._measurement == \"vehicle_count\" and r.class == \"total\")\n  |> sum(column: \"_value\")\n  |> yield(name: \"total_vehicles\")",
          "refId": "A"
        }
      ],
      "title": "Total Vehicles (last min)",
      "type": "stat"
    },
    {
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
