# Ensure consistent line endings across platforms

# Default: auto normalise to LF in repo
* text=auto eol=lf

# Shell scripts — must use LF on Linux/Pi hosts
*.sh text eol=lf

# Python — LF
*.py text eol=lf

# YAML / config — LF
*.yaml text eol=lf
*.yml  text eol=lf

# Markdown / docs
*.md   text eol=lf
*.txt  text eol=lf

# JSON
*.json text eol=lf

# Dockerfiles
Dockerfile text eol=lf

# Windows-native files (if any ever added)
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary model files — do not attempt line-ending normalisation
*.hef  binary
*.onnx binary
*.pt   binary
*.weights binary
