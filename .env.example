# Environment variables template — copy to .env and fill in values
# DO NOT commit .env to version control

# ─── InfluxDB ───────────────────────────────────────────────────────────────
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=your-super-secret-token-here
INFLUXDB_ORG=smartcity
INFLUXDB_BUCKET=traffic
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=adminpassword123
DOCKER_INFLUXDB_INIT_ORG=smartcity
DOCKER_INFLUXDB_INIT_BUCKET=traffic
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=your-super-secret-token-here

# ─── Grafana ─────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=adminpassword123

# ─── MQTT ────────────────────────────────────────────────────────────────────
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883

# ─── Edge Node ───────────────────────────────────────────────────────────────
NODE_ID=node-1
CAMERA_RESOLUTION_W=1280
CAMERA_RESOLUTION_H=720
CAMERA_FPS=30
